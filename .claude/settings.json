{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\proteger_archivos.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\bloquear_comandos.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\ejecutar_tests.py\""
          },
          {
            "type": "command",
            "command": "py -3 \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\auditoria.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\auditoria.py\""
          }
        ]
      }
    ]
  }
}
